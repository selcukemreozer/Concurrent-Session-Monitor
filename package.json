{
  "name": "concurrent-session-monitor",
  "version": "0.1.0",
  "description": "Real-time visibility into multiple parallel Claude Code sessions: which files each session is touching and what work is being done.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "build": "esbuild src/panel/entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/panel.mjs --alias:react-devtools-core=./scripts/rdc-stub.mjs --banner:js=$'#!/usr/bin/env node\\nimport{createRequire as __cr}from\"node:module\";const require=__cr(import.meta.url);' --jsx=automatic"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19",
    "tsx": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
